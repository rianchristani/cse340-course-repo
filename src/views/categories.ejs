<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>

        <p><% if (user && user.role_name === 'admin') { %><a href="/new-category">Add New Category</a><% } %></p>

        <ul>
            <% if (categories && categories.length > 0) { %>
                <% categories.forEach(category => { %>
                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                        <% if (user && user.role_name === 'admin') { %><a href="/edit-category/<%= category.category_id %>">Edit</a><% } %>
                    </li>
                <% }); %>
            <% } else { %>
                <li>No categories found.</li>
            <% } %>
        </ul>

        <img class="main-logo" src="images/cse340-service-network.png" alt="CSE 340 Service Network Logo">
    </main>

<%- include('partials/footer') %>