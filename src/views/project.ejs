<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <h2><%= project.title %></h2>

        <p><strong>Description:</strong> <%= project.description %></p>
        <p><strong>Date:</strong> <%= project.date %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        
        <p>
            <strong>Organization:</strong> 
            <a href="/organizations/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <p>
            <strong>Categories:</strong>
            <% if (categories && categories.length > 0) { %>
                <% categories.forEach((category, index) => { %>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a><%= index < categories.length - 1 ? ', ' : '' %>
                <% }); %>
            <% } else { %>
                None
            <% } %>
        </p>

        <p>
            <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
            <a href="/assign-categories/<%= project.project_id %>">Edit Project Categories</a>
            <% } %>
        </p>

            <% if (isLoggedIn) { %>
            <div class="volunteer-section">
                <% if (isVolunteered) { %>
                    <p><strong>You are volunteering for this project!</strong></p>
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                        <button type="submit" class="btn btn-danger">Remove as Volunteer</button>
                    </form>
                <% } else { %>
                    <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                        <button type="submit" class="btn btn-primary">Volunteer for this Project</button>
                    </form>
                <% } %>
            </div>
        <% } %>

    </main>

<%- include('partials/footer') %>