<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
        
        <ul>
            <% if (projects && projects.length > 0) { %>
                <% projects.forEach(project => { %>
                    <% 
                    
                        const formattedDate = new Date(project.project_date).toLocaleDateString('en-US', {
                            month: '2-digit',
                            day: '2-digit',
                            year: 'numeric',
                            timeZone: 'UTC'
                        });
                    %>
                    <li>
                        <strong><%= formattedDate %></strong>: <%= project.title %> (<%= project.organization_name %>)
                        
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a> 
                        
                    
                        (<a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>)
                    </li>
                <% }); %>
            <% } else { %>
                <li>No upcoming service projects found.</li>
            <% } %>
        </ul>
    </main>
<%- include('partials/footer') %>