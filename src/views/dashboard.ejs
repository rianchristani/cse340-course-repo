<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <section class="admin-tools">
            <h3>Admin Tools</h3>
            <p><a href="/users">Manage Users</a></p>
        </section>
    <% } %>

    <section class="volunteered-projects">
        <h3>My Volunteered Projects</h3>
        <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
            <ul>
                <% volunteeredProjects.forEach(proj => { %>
                    <li>
                        <a href="/project/<%= proj.project_id %>"><%= proj.title %></a>
                        <form action="/project/<%= proj.project_id %>/unvolunteer" method="POST" style="display:inline;">
                            <button type="submit">Remove</button>
                        </form>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>You have not signed up to volunteer for any projects yet.</p>
        <% } %>
    </section>

</main>

<%- include('partials/footer') %>